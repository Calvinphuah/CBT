rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may only touch documents carrying their own uid.
    // Queries must filter on userId or Firestore rejects them outright.
    function ownsExisting() {
      return request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // userId is set once at create and can never be reassigned.
    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /cbtEntries/{entryId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && keepsOwner();
    }

    match /gratitudeEntries/{entryId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && keepsOwner();
    }

    // Everything else is denied.
  }
}
